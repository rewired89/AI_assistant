{
  "$defs": {
    "animation_name": {"enum": ["idle","happy","sad","angry","sleepy","excited","curious","confused","listening","thinking","talking","playing","eating","sleeping","waking","surprised","affectionate","reflective","calm","celebratory","offline"]},
    "voice_style": {"enum": ["normal","happy","excited","sleepy","sad","surprised","affectionate","calm","whisper"]},
    "stream_no": {"type": "integer", "minimum": 1, "maximum": 65535},
    "ident": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "power_state": {"enum": ["AWAKE","IDLE","SLEEPING","WAKING","LOW_BATTERY","CRITICAL_BATTERY"]},
    "update_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{4,64}$"},
    "ota_manifest": {"type": "object", "additionalProperties": false,
      "required": ["product", "board", "version", "build", "size", "sha256", "created", "sign_kid"],
      "properties": {
        "product": {"type": "string", "pattern": "^[a-z0-9-]{1,32}$"}, "board": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,32}$"},
        "version": {"type": "string", "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}(-[a-z0-9.]{1,16})?$"},
        "build": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "requires_build": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "size": {"type": "integer", "minimum": 1, "maximum": 8388608},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "created": {"type": "string", "maxLength": 40},
        "sign_kid": {"type": "integer", "minimum": 1, "maximum": 1000}}},
    "error_code": {"enum": ["invalid_payload","unsupported_command","invalid_state","unsafe","not_allowed","busy","timeout","internal"]}
  },
  "commands": {
    "animation.play": {"type":"object","required":["name"],"additionalProperties":false,"properties":{
      "name":{"$ref":"#/$defs/animation_name"},"loop":{"type":"boolean"},"priority":{"type":"integer","minimum":0,"maximum":10}}},
    "animation.stop": {"type":"object","additionalProperties":false,"properties":{}},
    "display.set_expression": {"type":"object","required":["expression"],"additionalProperties":false,"properties":{
      "expression":{"$ref":"#/$defs/animation_name"}}},
    "display.set_brightness": {"type":"object","required":["level"],"additionalProperties":false,"properties":{
      "level":{"type":"integer","minimum":0,"maximum":100}}},
    "audio.play": {"type":"object","required":["stream_id","stream_no","format"],"additionalProperties":false,"properties":{
      "stream_id":{"$ref":"#/$defs/ident"},"stream_no":{"$ref":"#/$defs/stream_no"},"format":{"enum":["pcm16_16k_mono","opus"]},
      "style":{"$ref":"#/$defs/voice_style"},"volume":{"type":"integer","minimum":0,"maximum":100}}},
    "audio.start_capture": {"type":"object","required":["capture_id","stream_no","max_seconds"],"additionalProperties":false,"properties":{
      "capture_id":{"$ref":"#/$defs/ident"},"stream_no":{"$ref":"#/$defs/stream_no"},"max_seconds":{"type":"integer","minimum":1,"maximum":30}}},
    "audio.stop_playback": {"type":"object","required":["stream_id"],"additionalProperties":false,"properties":{
      "stream_id":{"$ref":"#/$defs/ident"}}},
    "audio.stop_capture": {"type":"object","required":["capture_id"],"additionalProperties":false,"properties":{
      "capture_id":{"$ref":"#/$defs/ident"}}},
    "power.sleep": {"type":"object","required":["reason","requested_by"],"additionalProperties":false,"properties":{
      "wake_at":{"type":["string","null"],"maxLength":40},
      "reason":{"enum":["battery_saving","user_request","scheduled"]},
      "requested_by":{"enum":["user","system"]}}},
    "power.wake": {"type":"object","required":["reason"],"additionalProperties":false,"properties":{
      "reason":{"enum":["user_request","host_request"]}}},
    "security.rotate_key": {"type":"object","required":["kid","key"],"additionalProperties":false,"properties":{
      "kid":{"type":"integer","minimum":2,"maximum":1000000},
      "key":{"type":"string","pattern":"^[0-9a-f]{64}$","description":"New 256-bit HMAC key, hex. Accepted only over a TLS channel."}}},
    "ota.begin": {"type":"object","required":["update_id","stream_no","manifest","signature"],"additionalProperties":false,"properties":{
      "update_id":{"$ref":"#/$defs/update_id"},"stream_no":{"$ref":"#/$defs/stream_no"},"manifest":{"$ref":"#/$defs/ota_manifest"},
      "signature":{"type":"string","pattern":"^[A-Za-z0-9+/]{64,200}={0,2}$","description":"base64 ECDSA P-256 / SHA-256 (DER) over the canonical manifest JSON"}}},
    "ota.abort": {"type":"object","required":["update_id"],"additionalProperties":false,"properties":{"update_id":{"$ref":"#/$defs/update_id"}}},
    "ota.apply": {"type":"object","required":["update_id"],"additionalProperties":false,"properties":{"update_id":{"$ref":"#/$defs/update_id"}}},
    "ota.confirm": {"type":"object","required":["update_id"],"additionalProperties":false,"properties":{"update_id":{"$ref":"#/$defs/update_id"}}},
    "device.get_status": {"type":"object","additionalProperties":false,"properties":{}},
    "device.set_config": {"type":"object","required":["config"],"additionalProperties":false,"properties":{
      "config":{"type":"object","minProperties":1,"additionalProperties":false,"properties":{
        "volume":{"type":"integer","minimum":0,"maximum":100},
        "default_brightness":{"type":"integer","minimum":0,"maximum":100},
        "idle_sleep_seconds":{"type":"integer","minimum":30,"maximum":86400},
        "mic_enabled":{"const":false,"description":"Host may only mute. Unmuting requires a physical action."}}}}}
  },
  "events": {
    "device.ready": {"type":"object","required":["firmware_version","protocol_versions","boot_cause","recovered_state"],"additionalProperties":false,"properties":{
      "firmware_version":{"type":"string","maxLength":32},"protocol_versions":{"type":"array","items":{"type":"integer"},"minItems":1},
      "boot_cause":{"enum":["power_on","timer","button","reset"]},"recovered_state":{"type":"boolean"},
      "build":{"type":"integer","minimum":1}}},
    "button.pressed": {"type":"object","required":["button","kind"],"additionalProperties":false,"properties":{
      "button":{"$ref":"#/$defs/ident"},"kind":{"enum":["single","double","long"]}}},
    "touch.detected": {"type":"object","required":["zone"],"additionalProperties":false,"properties":{"zone":{"$ref":"#/$defs/ident"}}},
    "battery.updated": {"type":"object","required":["percent","power_state","warning"],"additionalProperties":false,"properties":{
      "percent":{"type":"integer","minimum":0,"maximum":100},"power_state":{"$ref":"#/$defs/power_state"},"warning":{"type":"boolean"}}},
    "audio.capture.started": {"type":"object","required":["capture_id"],"additionalProperties":false,"properties":{"capture_id":{"$ref":"#/$defs/ident"}}},
    "audio.capture.chunk": {"type":"object","required":["capture_id","seq","size"],"additionalProperties":false,"properties":{
      "capture_id":{"$ref":"#/$defs/ident"},"seq":{"type":"integer","minimum":0},"size":{"type":"integer","minimum":0,"maximum":8192}}},
    "audio.playback.finished": {"type":"object","required":["stream_id","result","bytes_played","underruns"],"additionalProperties":false,"properties":{
      "stream_id":{"$ref":"#/$defs/ident"},"result":{"enum":["completed","interrupted","error"]},
      "bytes_played":{"type":"integer","minimum":0},"underruns":{"type":"integer","minimum":0}}},
    "audio.capture.stopped": {"type":"object","required":["capture_id","reason"],"additionalProperties":false,"properties":{
      "capture_id":{"$ref":"#/$defs/ident"},"reason":{"enum":["host_request","timeout","low_battery","muted"]}}},
    "animation.finished": {"type":"object","required":["name","interrupted"],"additionalProperties":false,"properties":{
      "name":{"$ref":"#/$defs/animation_name"},"interrupted":{"type":"boolean"}}},
    "power.sleeping": {"type":"object","required":["reason","wake_at"],"additionalProperties":false,"properties":{
      "reason":{"enum":["battery_saving","user_request","scheduled","idle","critical_battery"]},"wake_at":{"type":["string","null"]}}},
    "power.waking": {"type":"object","required":["cause"],"additionalProperties":false,"properties":{"cause":{"enum":["scheduled","button","host_request","reset"]}}},
    "power.woke": {"type":"object","required":["cause"],"additionalProperties":false,"properties":{"cause":{"enum":["scheduled","button","host_request","reset"]},
      "sleep_reason":{"enum":["battery_saving","user_request","scheduled","idle","critical_battery"]}}},
    "ota.progress": {"type":"object","required":["update_id","received","size"],"additionalProperties":false,"properties":{
      "update_id":{"$ref":"#/$defs/update_id"},"received":{"type":"integer","minimum":0},"size":{"type":"integer","minimum":1}}},
    "ota.verified": {"type":"object","required":["update_id","build"],"additionalProperties":false,"properties":{
      "update_id":{"$ref":"#/$defs/update_id"},"build":{"type":"integer","minimum":1}}},
    "ota.failed": {"type":"object","required":["update_id","reason"],"additionalProperties":false,"properties":{
      "update_id":{"$ref":"#/$defs/update_id"},
      "reason":{"enum":["bad_chunk","size_mismatch","hash_mismatch","low_battery","aborted","power_state","busy","write_error","timeout"]}}},
    "ota.applying": {"type":"object","required":["update_id","build"],"additionalProperties":false,"properties":{
      "update_id":{"$ref":"#/$defs/update_id"},"build":{"type":"integer","minimum":1}}},
    "ota.committed": {"type":"object","required":["update_id","build","version"],"additionalProperties":false,"properties":{
      "update_id":{"$ref":"#/$defs/update_id"},"build":{"type":"integer","minimum":1},"version":{"type":"string","maxLength":32}}},
    "ota.rolled_back": {"type":"object","required":["update_id","from_build","to_build","reason"],"additionalProperties":false,"properties":{
      "update_id":{"$ref":"#/$defs/update_id"},"from_build":{"type":"integer","minimum":0},"to_build":{"type":"integer","minimum":0},
      "reason":{"enum":["confirm_timeout","self_test_failed","boot_failures"]}}},
    "command.accepted": {"type":"object","required":["command_id","command_type"],"additionalProperties":false,"properties":{
      "command_id":{"type":"string"},"command_type":{"type":"string"}}},
    "command.completed": {"type":"object","required":["command_id"],"additionalProperties":false,"properties":{
      "command_id":{"type":"string"},"result":{"type":"object"}}},
    "command.failed": {"type":"object","required":["command_id","code","message"],"additionalProperties":false,"properties":{
      "command_id":{"type":"string"},"code":{"$ref":"#/$defs/error_code"},"message":{"type":"string","maxLength":200}}}
  }
}
