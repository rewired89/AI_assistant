menu "Nine Tails network test"
    config NT_WIFI_SSID
        string "Wi-Fi name (2.4 GHz)"
        default ""
    config NT_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""
    config NT_HOST_IP
        string "Companion host address"
        default "192.168.1.42"
    config NT_HOST_PORT
        int "Companion host port"
        default 8443
    config NT_DEVICE_ID
        string "Device id (from the provisioning bundle)"
        default "ninetails-01"
    config NT_DEVICE_KEY_HEX
        string "Device key, 64 hex characters (SECRET, from the provisioning bundle, never committed)"
        default ""
endmenu
